# SQLite database file path (use :memory: for ephemeral/test runs)
SQLITE_URL=database.db

# Port the Express server listens on
PORT=3001

# Secret used to sign JWTs — use a long random string in production
SECRET=change-me-to-a-long-random-string

# Password for the auto-created default admin account (username: admin)
ADMIN_PASSWORD=change-me
